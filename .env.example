# FestToken Environment Configuration
# Flask Backend
FLASK_APP=backend.app:create_app
FLASK_ENV=development
SECRET_KEY=festtoken-dev-secret-key-change-in-production-2026
JWT_SECRET_KEY=festtoken-jwt-secret-key-change-in-production-2026
PORT=5000

# Database
# Default SQLite file storage (WAL mode enabled automatically)
# In production with PostgreSQL: postgresql://user:password@localhost:5432/festtoken
DATABASE_URL=sqlite:///instance/festtoken.db

# Security & Session
SESSION_TIMEOUT_MINUTES=480
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60
